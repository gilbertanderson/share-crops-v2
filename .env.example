# Copy to .env.local and fill in. These point the app at the SAME deployed
# Supabase backend (Edge Functions) used by the original shareCropsApp.

# ---------------------------------------------------------------------------
# Firebase web app config (client-safe; gated by Auth + Firestore rules +
# Authorized Domains). Fill from:
#   npx -y firebase-tools@latest apps:sdkconfig WEB <APP_ID> --project <PROJECT_ID>
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=


# Supabase project reference ID
VITE_SUPABASE_PROJECT_ID=your_project_id_here

# Supabase public anon key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Fallback backend base URL (the Vercel deployment of the same Hono app).
# Leave blank to disable failover. Example:
#   https://your-app.vercel.app/api/make-server-dd877831
VITE_FALLBACK_API_URL=

# ---------------------------------------------------------------------------
# Server-side only — consumed by @supabase/server (NO VITE_ prefix, so Vite
# never exposes these to the browser bundle). Set these in your hosting
# provider's env (Vercel/Supabase) for production; in .env.local for local dev.
# Supabase Edge Functions inject SUPABASE_URL / keys automatically.
# ---------------------------------------------------------------------------

# Supabase project URL.
SUPABASE_URL=https://your_project_id_here.supabase.co

# Publishable (client-grade) key. Safe to expose; used for the RLS-scoped client.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret key — SERVER ONLY. Bypasses RLS via the admin client. Never ship to the
# browser, never commit the real value. Rotate immediately if leaked.
SUPABASE_SECRET_KEY=sb_secret_xxx

# JWKS endpoint @supabase/server uses to verify user JWTs locally (no network
# round-trip to auth on every request).
SUPABASE_JWKS_URL=https://your_project_id_here.supabase.co/auth/v1/.well-known/jwks.json

# Anthropic API key — SERVER ONLY. Powers the AI listing-description assistant
# (/listings/draft-description). When unset, that endpoint returns 503 and the
# rest of the app is unaffected. Never expose to the browser.
ANTHROPIC_API_KEY=sk-ant-xxx

# Firebase service-account JSON — SERVER ONLY (Node/Vercel function). The Vercel
# backend uses this with the Admin SDK to verify Firebase ID tokens sent by the
# frontend (server/firebaseAdmin.ts). Paste the entire service-account JSON as a
# single-line string. Generate it in Firebase Console → Project settings →
# Service accounts → Generate new private key. If unset, the function falls back
# to Application Default Credentials. Never expose to the browser.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"share-crops-app",...}
