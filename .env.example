# Copy to .env.local and fill in. The app uses Firebase Auth in the browser and
# one Node/Hono API backend for all marketplace data access.

# ---------------------------------------------------------------------------
# Firebase web app config (client-safe; gated by Auth + Firestore rules +
# Authorized Domains). Fill from:
#   npx -y firebase-tools@latest apps:sdkconfig WEB <APP_ID> --project <PROJECT_ID>
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
# MUST be <project>.firebaseapp.com — NOT your Vercel site URL.
# Production: share-crops-app.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Web Push (FCM): Firebase console → Cloud Messaging → Web Push certificates → key pair
VITE_FIREBASE_VAPID_KEY=

# API base override. Leave blank on the primary host for same-origin `/api/...`.
# Backup API host (fallback deployment):
#   https://share-crops-marketplace.vercel.app/api/make-server-dd877831
VITE_FALLBACK_API_URL=

# ---------------------------------------------------------------------------
# Server-side only — consumed by the Node API (NO VITE_ prefix, so Vite never
# exposes these to the browser bundle). Set these in Vercel for production; in
# .env.local for local API development.
# ---------------------------------------------------------------------------

# Supabase project URL.
SUPABASE_URL=https://your_project_id_here.supabase.co

# Supabase anon key. Server uses this only for compatibility routes that call
# Supabase Auth; marketplace data access uses the service-role key below.
SUPABASE_ANON_KEY=your_anon_key_here

# Service-role key — SERVER ONLY. Bypasses RLS via the admin client. Never ship
# to the browser, never commit the real value. Rotate immediately if leaked.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional image storage: Netlify Blobs (SERVER ONLY). When BOTH are set, /upload
# returns a stable same-origin URL (…/images/<key>) instead of an expiring
# Supabase signed URL. Works from Vercel too — only needs site ID + API token.
#   Site ID: Netlify → Site configuration → Site details → Site ID
#   Token:   Netlify → User settings → Applications → Personal access tokens
NETLIFY_BLOBS_SITE_ID=
NETLIFY_BLOBS_TOKEN=

ADMIN_EMAIL=admin@example.com  # e.g. gilbertandersonwork@gmail.com — gets role=admin on signup/login
DEFAULT_ORIGIN=http://localhost:5173
# Primary + fallback production hosts (see scripts/domains.mjs)
CORS_ORIGINS=http://localhost:5173,https://share-crops-v2.vercel.app,https://share-crops-marketplace.vercel.app
SKIP_INIT=false
KV_TABLE_NAME=kv_store_dd877831
STORAGE_BUCKET_NAME=share-crops-uploads
APP_ID=dd877831

# Anthropic API key — SERVER ONLY. Powers the AI listing-description assistant
# (/listings/draft-description). When unset, that endpoint returns 503 and the
# rest of the app is unaffected. Never expose to the browser.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional; defaults to claude-haiku-4-5-20251001
# ANTHROPIC_DRAFT_MODEL=claude-haiku-4-5-20251001

# Firebase service-account JSON — SERVER ONLY (Node/Vercel function). The Vercel
# backend uses this with the Admin SDK to verify Firebase ID tokens sent by the
# frontend (server/firebaseAdmin.ts). Paste the entire service-account JSON as a
# single-line string. Generate it in Firebase Console → Project settings →
# Service accounts → Generate new private key. If unset, the function falls back
# to Application Default Credentials. Never expose to the browser.
FIREBASE_SERVICE_ACCOUNT=your_service_account_json_single_line
