# Copy to .env.local and fill in. These point the app at the SAME deployed
# Supabase backend (Edge Functions) used by the original shareCropsApp.

# Supabase project reference ID
VITE_SUPABASE_PROJECT_ID=your_project_id_here

# Supabase public anon key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Fallback backend base URL (the Vercel deployment of the same Hono app).
# Leave blank to disable failover. Example:
#   https://your-app.vercel.app/api/make-server-dd877831
VITE_FALLBACK_API_URL=

# ---------------------------------------------------------------------------
# Server-side only — consumed by @supabase/server (NO VITE_ prefix, so Vite
# never exposes these to the browser bundle). Set these in your hosting
# provider's env (Vercel/Supabase) for production; in .env.local for local dev.
# Supabase Edge Functions inject SUPABASE_URL / keys automatically.
# ---------------------------------------------------------------------------

# Supabase project URL.
SUPABASE_URL=https://your_project_id_here.supabase.co

# Publishable (client-grade) key. Safe to expose; used for the RLS-scoped client.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret key — SERVER ONLY. Bypasses RLS via the admin client. Never ship to the
# browser, never commit the real value. Rotate immediately if leaked.
SUPABASE_SECRET_KEY=sb_secret_xxx

# JWKS endpoint @supabase/server uses to verify user JWTs locally (no network
# round-trip to auth on every request).
SUPABASE_JWKS_URL=https://your_project_id_here.supabase.co/auth/v1/.well-known/jwks.json
